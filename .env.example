# ═══════════ Lighter Guardian ═══════════
# Скопируй этот файл в .env и заполни. Файл .env никогда не публикуй.

# Режим проверки: true — страж только пишет, что СДЕЛАЛ БЫ, ничего не отправляя на биржу.
# Поработай так день-два, убедись, что сообщения правильные, потом поставь false.
DRY_RUN=true

# ── Кошельки ──
# Каждый кошелёк — свой номер: W1_, W2_, W3_ …
# Кошелёк на RH и на основном Lighter (CORE) один и тот же: адрес пишется один раз,
# номера аккаунтов на обеих биржах страж найдёт сам. Ключи создаются командой:
#   python setup_key.py --wallet 1 --name Основной
# Вилки (тот же тикер в разные стороны) ищутся внутри одного кошелька: RH №1 ↔ CORE №1.

W1_ADDRESS=0x...
W1_NAME=Основной
W1_RH_API_KEY_INDEX=4
W1_RH_API_PRIVATE_KEY=
W1_CORE_API_KEY_INDEX=4
W1_CORE_API_PRIVATE_KEY=

# W2_ADDRESS=0x...
# W2_NAME=Второй
# W2_RH_API_KEY_INDEX=4
# W2_RH_API_PRIVATE_KEY=
# W2_CORE_API_KEY_INDEX=4
# W2_CORE_API_PRIVATE_KEY=

# Необязательно:
# W1_RH_ACCOUNT_INDEX=     # если нужен конкретный субаккаунт, а не основной
# W1_RH_NETWORK=robinhood_testnet   # тестнет (для CORE: testnet)

# ── Прокси (необязательно) ──
# Весь трафик стража пойдёт через этот прокси. Формат: http://логин:пароль@хост:порт
PROXY=

# ── Telegram ── свой бот от @BotFather + твой chat id (узнать: @userinfobot)
TG_TOKEN=
TG_CHAT_ID=

# ── Сценарии: act — действовать, alert — только сообщать, off — выключено ──
# 1. Позиция закрылась → отменить оставшиеся TP/SL по этой паре
CLEANUP=act
# 2. Стоп сработал, но биржа его отменила (проскальзывание / нет ликвидности) → закрыть позицию
FAILED_STOP=act
# 3. Цена в стакане за стопом, а стоп не исполнился → закрыть позицию
SOFT_STOP=act
# сколько секунд цена должна держаться за стопом, прежде чем страж закроет сам
SOFT_STOP_SECONDS=5
# насколько цена должна уйти за триггер, %, чтобы считаться пробоем (защита от касаний)
SOFT_STOP_BUFFER_PCT=0.05
# 4. Предупреждать о позиции без стоп-лосса (через сколько минут)
NAKED_ALERT=true
NAKED_ALERT_MIN=2

# 5. Вилка: тот же тикер в разные стороны на RH и CORE (нужны ключи обеих бирж).
#    Одна нога закрылась → закрыть вторую; уменьшилась → подрезать вторую пропорционально.
HEDGE=act
# сколько секунд ждать, пока нога «успокоится» (стоп/тейк часто исполняется кусками)
HEDGE_DEBOUNCE_SEC=0.7

# ── Аварийное закрытие и подрезка вилки ──
# допуск по цене на первой попытке, %; на 2-й — вдвое, на 3-й — втрое
EMERGENCY_SLIPPAGE_PCT=1
EMERGENCY_TRIES=3

LOG_LEVEL=INFO
