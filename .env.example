# ═══════════ Lighter Guardian ═══════════
# Скопируй этот файл в .env и заполни. Файл .env никогда не публикуй.

# Режим проверки: true — страж только пишет, что СДЕЛАЛ БЫ, ничего не отправляя на биржу.
# Поработай так день-два, убедись, что сообщения правильные, потом поставь false.
DRY_RUN=true

# ── Ключи, адреса кошельков, прокси, токен Telegram — НЕ здесь ──
# Они лежат в зашифрованном хранилище guardian.vault:
#   python vault.py init                          создать хранилище
#   python vault.py wallet                        кошелёк с API-ключами, созданными на сайте Lighter
#   (или python setup_key.py --wallet 1 — ключи скриптом)
#   python vault.py set TG_TOKEN / TG_CHAT_ID / PROXY / W1_PROXY
# Если положить ключи сюда открытым текстом, страж откажется запускаться.

# ── Telegram ──
# Насколько подробно писать в Telegram (переписка с ботами не шифруется сквозным шифрованием):
#   full    — всё: размеры позиций, цены, номера аккаунтов
#   short   — тикер и что произошло, без цифр (по умолчанию)
#   minimal — только что произошло и номер кошелька, без тикеров
TG_DETAIL=short

# ── Сценарии: act — действовать, alert — только сообщать, off — выключено ──
# 1. Позиция закрылась → отменить оставшиеся TP/SL по этой паре
CLEANUP=act
# 2. Стоп сработал, но биржа его отменила (проскальзывание / нет ликвидности) → закрыть позицию
FAILED_STOP=act
# 3. Цена в стакане за стопом, а стоп не исполнился → закрыть позицию
SOFT_STOP=act
# сколько секунд цена должна держаться за стопом, прежде чем страж закроет сам
SOFT_STOP_SECONDS=5
# насколько цена должна уйти за триггер, %, чтобы считаться пробоем (защита от касаний)
SOFT_STOP_BUFFER_PCT=0.05
# 4. Предупреждать о позиции без стоп-лосса (через сколько минут)
NAKED_ALERT=true
NAKED_ALERT_MIN=2

# 5. Вилка: тот же тикер в разные стороны на RH и CORE (нужны ключи обеих бирж).
#    Одна нога закрылась → закрыть вторую; уменьшилась → подрезать вторую пропорционально.
HEDGE=act
# пауза, секунд: одна нога закрылась/уменьшилась → ждём столько, и только потом трогаем вторую.
# Отсчёт идёт от последнего изменения ноги (стоп/тейк часто исполняется кусками).
# Если за это время вторая нога закроется сама (по своему тейку или стопу), страж её не трогает.
# Пока идёт пауза, вторая нога без пары. Меньше — быстрее хедж, больше — больше шанс, что вторая закроется сама.
HEDGE_DEBOUNCE_SEC=3

# ── Аварийное закрытие и подрезка вилки ──
# допуск по цене на первой попытке, %; на 2-й — вдвое, на 3-й — втрое
EMERGENCY_SLIPPAGE_PCT=1
EMERGENCY_TRIES=3

LOG_LEVEL=INFO
